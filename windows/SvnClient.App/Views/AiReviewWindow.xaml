<Window x:Class="SvnClient.App.Views.AiReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Review" Height="640" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ElevatedBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="ScopeText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                   VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
        <Grid Grid.Row="0" Margin="0,0,0,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="✦ AI Review" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Grid.Column="1" x:Name="MetaText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingText" Foreground="{DynamicResource TextBrush}" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="CPU-only models can take a minute or more." Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBox x:Name="ResultText" Visibility="Collapsed"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                         Padding="14" FontSize="13" FontFamily="Segoe UI"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenSettingsButton" Content="Open Settings" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="OpenSettings_Click"/>
            <Button x:Name="CopyButton" Content="Copy" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="Copy_Click"/>
            <Button Content="Close" Style="{DynamicResource PrimaryButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
